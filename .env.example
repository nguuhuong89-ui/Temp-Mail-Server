# ============================================================
# TempMail — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ---- PostgreSQL ------------------------------------------------
# Nếu dùng postgres riêng, thay user/pass/host tùy ý.
POSTGRES_USER=tempmail
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tempmail

# ---- Mail domain -----------------------------------------------
# Domain nhận email (MX record phải trỏ về server này).
# Ví dụ: mail.yourdomain.com
MAIL_DOMAIN=mail.example.com

# ---- SMTP ------------------------------------------------------
# Port SMTP nội bộ của container (luôn là 25 bên trong).
# SMTP_HOST_PORT: port host expose ra ngoài (đổi nếu 25 bị chiếm).
SMTP_PORT=25
SMTP_HOST_PORT=25

# ---- HTTP port -------------------------------------------------
HTTP_PORT=80

# ---- Admin panel -----------------------------------------------
# BẮT BUỘC trong production. Đặt chuỗi ngẫu nhiên dài ≥32 ký tự.
# Dùng: openssl rand -hex 32
ADMIN_TOKEN=replace_with_a_strong_random_secret

# ---- Clerk (user accounts) -------------------------------------
# Tùy chọn. Bỏ qua nếu không cần tính năng đăng ký/đăng nhập.
# Lấy từ Clerk Dashboard → API Keys.
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# URL Clerk proxy — phải khớp domain công khai của bạn.
# Ví dụ: https://mail.example.com/api/__clerk
VITE_CLERK_PROXY_URL=https://mail.example.com/api/__clerk

# ---- Admin emails ----------------------------------------------
# Danh sách email tự động được cấp quyền admin+pro khi đăng nhập lần đầu.
# Phân cách bằng dấu phẩy. Bỏ trống nếu không dùng.
ADMIN_EMAILS=admin@example.com

# ---- Logging ---------------------------------------------------
# Mức log: trace | debug | info | warn | error
LOG_LEVEL=info
