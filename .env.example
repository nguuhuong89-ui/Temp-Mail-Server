# ============================================================
# AutoMail — Environment Variables
# Copy this file to .env and fill in the values.
# See README.md for full documentation.
# ============================================================

# ================================================================
# DATABASE (required)
# ================================================================
# Full PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# If using the bundled postgres service in docker-compose.yml,
# keep this as-is and set POSTGRES_PASSWORD below.
DATABASE_URL=postgres://tempmail:change_me_strong_password@postgres:5432/tempmail

# Credentials used ONLY by the bundled postgres Docker service.
# If you supply an external DATABASE_URL, these are unused.
POSTGRES_USER=tempmail
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tempmail

# ================================================================
# MAIL (required)
# ================================================================
# The domain/subdomain that receives email.
# Your DNS MX record must point to this server's IP.
# Example: mail.yourdomain.com
MAIL_DOMAIN=mail.example.com

# ================================================================
# SMTP (required)
# ================================================================
# Port the embedded SMTP server listens on INSIDE the container.
# Leave this at 25 unless you have a specific reason to change it.
SMTP_PORT=25

# Port exposed on the HOST machine.
# Change to 2525 if port 25 is already in use or blocked by your provider.
# If you change this, update your DNS accordingly.
SMTP_HOST_PORT=25

# ================================================================
# HTTP
# ================================================================
# Host port for the Nginx web container.
HTTP_PORT=80

# ================================================================
# ADMIN PANEL (required in production)
# ================================================================
# Secret token to access the /admin panel.
# MUST be a long random string in production.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=replace_with_a_strong_random_secret

# ================================================================
# CLERK — User accounts (optional)
# ================================================================
# Skip this section if you don't need user login / registration.
# To enable: sign up at https://clerk.com, create an app, get your keys.
#
# Secret key from Clerk Dashboard → Configure → API Keys
CLERK_SECRET_KEY=sk_live_...

# Publishable key from Clerk Dashboard → Configure → API Keys
# This is also passed as a Docker build argument: VITE_CLERK_PUBLISHABLE_KEY
CLERK_PUBLISHABLE_KEY=pk_live_...

# Public URL of the Clerk JS proxy served by this app.
# Must exactly match your deployment domain including https://.
# Example: https://mail.yourdomain.com/api/__clerk
# This is also passed as a Docker build argument: VITE_CLERK_PROXY_URL
VITE_CLERK_PROXY_URL=https://mail.example.com/api/__clerk

# ================================================================
# ADMIN EMAILS (optional, requires Clerk)
# ================================================================
# Comma-separated list of email addresses that are automatically
# promoted to role=admin and plan=pro on their first login.
# Leave blank if you will manage roles manually in the admin panel.
ADMIN_EMAILS=admin@example.com

# ================================================================
# LOGGING
# ================================================================
# Log verbosity. Recommended: info (production), debug (development).
# Options: trace | debug | info | warn | error
LOG_LEVEL=info
